# QuadraBiz Enterprise Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Database (Leave empty for default SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/quadrabiz_db
# DB_CONN_MAX_AGE=600

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# API Security & Throttling
THROTTLE_ANON=150/minute
THROTTLE_USER=1000/minute

# JWT Token Lifespans
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=30

# Production Security
ENABLE_SSL_REDIRECT=False
LOG_LEVEL=INFO
